# ==========================================
# ROUNIYAR DECOR - ENVIRONMENT CONFIGURATION
# ==========================================

# Database Connection (Default: SQLite for zero-setup local dev. For PostgreSQL: postgresql://user:password@localhost:5432/rouniyardecor)
DATABASE_URL="file:./dev.db"

# JWT Auth Secret Key (Change this in production)
JWT_SECRET="rouniyar-decor-secure-jwt-auth-token-key-2025"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Razorpay Payment Gateway (Test mode credentials for preview / development)
# To use live payments, create an account on razorpay.com and place your Live Key ID & Secret
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_RouniyarDecorDemo101"
RAZORPAY_KEY_SECRET="rzp_test_secret_RouniyarDecorKey2025"

# Default Admin Credentials (Auto-seeded into DB)
ADMIN_EMAIL="admin@rouniyardecor.com"
ADMIN_PASSWORD="admin123"

# Optional Cloudinary Configuration for Image Uploads
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
